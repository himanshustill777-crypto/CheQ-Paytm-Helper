<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp"
 android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="CheQ Bill Helper" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="10dp"
 android:text="Prepare one bill-fetch request. OTP, PIN, CVV and payment are never handled."/>
<EditText android:id="@+id/bankName" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="18dp" android:hint="Bank / card issuer (e.g. ICICI Bank)" android:inputType="textCapWords"/>
<EditText android:id="@+id/last4" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:hint="Last 4 digits" android:inputType="number" android:maxLength="4"/>
<EditText android:id="@+id/mobile" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:hint="Registered mobile number" android:inputType="phone" android:maxLength="10"/>
<Button android:id="@+id/saveRequest" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="10dp" android:text="SAVE REQUEST"/>
<TextView android:id="@+id/requestStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="8dp" android:text="No request saved"/>
<Button android:id="@+id/accessibility" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="18dp" android:text="Enable Accessibility"/>
<Button android:id="@+id/openPaytm" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="OPEN PAYTM FOR SAVED REQUEST"/>
<TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="24dp" android:text="Bill result will appear here when readable."/>
<TextView android:id="@+id/debugStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="18dp" android:text="Debug Status: waiting" android:textSize="14sp"/>
</LinearLayout>
</ScrollView>